      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.0.4",
